<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Design Data Manager's Revit add-in. Build it with build_addin.py, which builds it once for
    each installed Revit year (2025 and later):
      dotnet build -c Release -p:RevitYear=2025 -p:DotNetVersion=10
    Revit 2025.5's API needs .NET 10; build_addin.py moves up when the API asks for it.
  -->
  <PropertyGroup>
    <!-- The .NET major version Revit's API was built for (8, or 10 since Revit 2025.5). -->
    <DotNetVersion Condition="'$(DotNetVersion)' == ''">8</DotNetVersion>
    <TargetFramework>net$(DotNetVersion).0-windows</TargetFramework>
    <RevitYear Condition="'$(RevitYear)' == ''">2025</RevitYear>
    <RevitPath Condition="'$(RevitPath)' == ''">C:\Program Files\Autodesk\Revit $(RevitYear)</RevitPath>
    <AssemblyName>DesignDataManager.Revit</AssemblyName>
    <RootNamespace>DesignDataManager.Revit</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Revit's API references WPF (WindowsBase); the ribbon uses its images. -->
    <UseWPF>true</UseWPF>
    <!-- No implicit usings: Windows Forms names such as View would clash with Revit's. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Design Data Manager</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- The JSON reader check is its own project. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- Each Revit year builds into obj\<year>, so the SDK only skips that one; skip every build
         folder, or files generated by another build (an editor's Debug build) are compiled twice. -->
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>

  <!-- Built from a Revit API reference package (build_addin.py sets RevitApiPackage for 2025): the
       build then targets that year's first .NET, so it loads on every update of that Revit, and
       doesn't need that Revit installed. Without it, the build uses the installed Revit's DLLs. -->
  <ItemGroup Condition="'$(RevitApiPackage)' != ''">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackage)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackage)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(RevitApiPackage)' == ''">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
